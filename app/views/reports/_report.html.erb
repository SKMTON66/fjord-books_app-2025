<div id="<%= dom_id report %>">

  <p>
    <strong><%= t('views.common.name_or_email') %>:</strong>
    <%= report.user ? report.user.display_name : t('helpers.common.deleted_user') %>
  </p>

  <p>
    <strong><%= t('views.common.post_date') %>:</strong>
    <%= l report.created_at, format: :long %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:title) %>:</strong>
    <%= report.title %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:content) %>:</strong>
    <%= report.content %>
  </p>

</div>
