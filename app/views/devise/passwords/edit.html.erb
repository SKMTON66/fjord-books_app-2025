<h2><%= t('views.users.change_your_password') %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <p><%= f.label :password, t('views.users.new_password') %></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> <%= t('views.users.characters_minimum') %>)</em></p>
    <% end %>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, t('views.users.confirm_new_password') %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit t('views.users.change_my_password') %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
