<% title = t('views.common.title_index', name: i18n_pluralize(User.model_name.human)) %>
<% content_for :title, title %>

<h1><%= title %></h1>

<div id="users">
  <% @users.each do |user| %>
    <%= user.username %>
    <%= user.email %>
    <p>
      <%= link_to t('views.common.show', name: User.model_name.human.downcase), user %>
    </p>
  <% end %>
</div>

<%= paginate @users %>

<%= link_to t('views.common.title_index', name: i18n_pluralize(Book.model_name.human.downcase)), books_path %>
