<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.username %>
  </div>

  <div>
    <strong>Address:</strong>
    <%= user.address %>
  </div>

  <div>
    <strong>Post code:</strong>
    <%= user.postcode %>
  </div>

  <div>
    <strong>Self introduction:</strong>
    <%= user.self_introduction %>
  </div>
</div>
