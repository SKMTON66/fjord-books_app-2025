<% comment = commentable.comments.build %>
<%= form_with(model: [commentable, comment]) do |form| %>
  <% if comment.errors.any? %>
    <div style="color: red">
      <h2><%= t('views.common.validation_error', errors: i18n_error_count(comment.errors.count), name: Comment.model_name.human.downcase) %>:</h2>

      <ul>
        <% comment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.textarea :content, required: true %>
  </div>

  <div>
    <%= form.button t('views.common.new_post', name: Comment.model_name.human) %>
  </div>
<% end %>
